  "forensic_notes": {
    "acquisition": [
      "Use MiniDumpWriteDump with MiniDumpWithFullMemory flag for complete dumps",
      "ProcDump (Sysinternals) can capture dumps without attaching a debugger",
      "Task Manager can create dumps but may not capture all memory regions",
      "WinDbg .dump /ma command provides most comprehensive dumps"
    ],
    "analysis_tips": [
      "Check PEB for loaded DLL list - malicious DLLs may be injected",
      "TLS slots may contain Ruby execution context pointers",
      "Windows heap metadata can help identify allocation patterns",
      "SEH chain analysis can reveal exception handler hijacking"
    ]
