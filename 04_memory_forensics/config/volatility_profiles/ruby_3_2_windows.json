{
  "profile_name": "ruby_3_2_windows",
  "ruby_version": "3.2.x",
  "platform": "windows",
  "architecture": "x86_64",
  "description": "Volatility profile for Ruby 3.2.x on Windows x86_64 (RubyInstaller). Contains Windows-specific structure offsets accounting for MSVC ABI differences and Windows thread/memory management.",
