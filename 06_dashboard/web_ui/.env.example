# =============================================================================
# RubyGuardian Web UI - Environment Variables
# =============================================================================
# Copy this file to .env and adjust values for your environment

# Backend API URL
VITE_API_BASE_URL=http://localhost:4000/api

# WebSocket URL for real-time events
VITE_WS_URL=ws://localhost:4000/ws

# Elasticsearch URL (for direct queries)
VITE_ES_URL=http://localhost:9200

# Kibana URL (for embedded dashboards)
VITE_KIBANA_URL=http://localhost:5601

# Grafana URL (for embedded dashboards)
VITE_GRAFANA_URL=http://localhost:3000

# Application settings
VITE_APP_TITLE=RubyGuardian Security Dashboard
VITE_REFRESH_INTERVAL=30000
VITE_MAX_EVENTS_DISPLAY=500

# Feature flags
VITE_ENABLE_WEBSOCKET=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_DARK_MODE=true
