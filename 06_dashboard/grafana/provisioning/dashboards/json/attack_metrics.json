          "metrics": [{ "field": "threat_score", "id": "1", "type": "avg" }],
          "query": "",
          "refId": "A",
          "timeField": "@timestamp"
        },
        {
          "alias": "Max Threat Score",
          "bucketAggs": [{ "field": "@timestamp", "id": "2", "settings": { "interval": "auto", "min_doc_count": "0" }, "type": "date_histogram" }],
          "metrics": [{ "field": "threat_score", "id": "1", "type": "max" }],
