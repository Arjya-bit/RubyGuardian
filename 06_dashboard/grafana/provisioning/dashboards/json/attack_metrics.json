  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 200,
      "title": "Attack Summary",
      "type": "row"
    },
    {
      "datasource": { "type": "elasticsearch", "uid": "rg-es-events" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          }
        }
      },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["count"], "fields": "", "values": false } },
      "title": "Total Attacks (24h)",
      "type": "stat",
      "targets": [
        {
          "bucketAggs": [{ "field": "@timestamp", "id": "2", "settings": { "interval": "1h", "min_doc_count": "0" }, "type": "date_histogram" }],
          "metrics": [{ "id": "1", "type": "count" }],
          "query": "severity: (critical OR high)",
          "refId": "A",
          "timeField": "@timestamp"
        }
      ]
    },
    {
      "datasource": { "type": "elasticsearch", "uid": "rg-es-events" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["count"], "fields": "", "values": false } },
      "title": "Process Hollowing Detections",
      "type": "stat",
      "targets": [
        {
          "bucketAggs": [],
          "metrics": [{ "id": "1", "type": "count" }],
          "query": "attack.technique: process_hollowing",
          "refId": "A",
          "timeField": "@timestamp"
        }
      ]
    },
    {
      "datasource": { "type": "elasticsearch", "uid": "rg-es-events" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["count"], "fields": "", "values": false } },
      "title": "Supply Chain Alerts",
      "type": "stat",
      "targets": [
        {
          "bucketAggs": [],
          "metrics": [{ "id": "1", "type": "count" }],
          "query": "attack.category: supply_chain",
          "refId": "A",
          "timeField": "@timestamp"
        }
      ]
    },
    {
      "datasource": { "type": "elasticsearch", "uid": "rg-es-events" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          }
        }
      },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["count"], "fields": "", "values": false } },
      "title": "LOLRuby Detections",
      "type": "stat",
      "targets": [
        {
          "bucketAggs": [],
          "metrics": [{ "id": "1", "type": "count" }],
          "query": "attack.category: lolruby OR ruby.eval_detected: true",
          "refId": "A",
          "timeField": "@timestamp"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 },
      "id": 201,
      "title": "Attack Trends",
      "type": "row"
    },
    {
      "datasource": { "type": "elasticsearch", "uid": "rg-es-events" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 25,
            "gradientMode": "opacity",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "never",
            "stacking": { "group": "A", "mode": "normal" }
          }
        }
      },
      "gridPos": { "h": 12, "w": 16, "x": 0, "y": 7 },
      "id": 5,
      "options": { "legend": { "calcs": ["sum", "mean"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "title": "Attacks by Category Over Time",
      "type": "timeseries",
      "targets": [
        {
          "alias": "{{term attack.category}}",
          "bucketAggs": [
            { "field": "attack.category", "id": "3", "settings": { "min_doc_count": "1", "order": "desc", "orderBy": "_count", "size": "10" }, "type": "terms" },
            { "field": "@timestamp", "id": "2", "settings": { "interval": "auto", "min_doc_count": "0" }, "type": "date_histogram" }
          ],
          "metrics": [{ "id": "1", "type": "count" }],
          "query": "attack.category: *",
          "refId": "A",
          "timeField": "@timestamp"
        }
      ]
    },
    {
      "datasource": { "type": "elasticsearch", "uid": "rg-es-events" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "hideFrom": { "legend": false, "tooltip": false, "viz": false } }
        }
      },
      "gridPos": { "h": 12, "w": 8, "x": 16, "y": 7 },
      "id": 6,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "values": ["value", "percent"] },
        "pieType": "donut",
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "tooltip": { "mode": "single" }
      },
      "title": "Attack Category Distribution",
      "type": "piechart",
      "targets": [
        {
          "alias": "{{term attack.category}}",
          "bucketAggs": [{ "field": "attack.category", "id": "2", "settings": { "min_doc_count": "1", "order": "desc", "orderBy": "_count", "size": "10" }, "type": "terms" }],
          "metrics": [{ "id": "1", "type": "count" }],
          "query": "attack.category: *",
          "refId": "A",
          "timeField": "@timestamp"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 19 },
