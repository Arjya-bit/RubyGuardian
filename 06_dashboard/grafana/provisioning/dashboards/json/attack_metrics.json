      "type": "barchart",
      "targets": [
        {
          "alias": "{{term mitre.technique_name}}",
          "bucketAggs": [{ "field": "mitre.technique_name", "id": "2", "settings": { "min_doc_count": "1", "order": "desc", "orderBy": "_count", "size": "15" }, "type": "terms" }],
          "metrics": [{ "id": "1", "type": "count" }],
          "query": "mitre.technique_name: *",
          "refId": "A",
          "timeField": "@timestamp"
        }
      ]
    },
