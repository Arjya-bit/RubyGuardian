          "metrics": [{ "id": "1", "type": "count" }],
          "query": "mitre.tactic: *",
          "refId": "A",
          "timeField": "@timestamp"
        }
      ]
    },
    {
      "datasource": { "type": "elasticsearch", "uid": "rg-es-events" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
