# frozen_string_literal: true
#
# RubyGuardian - Vulnerable Rails App Gemfile
# PURPOSE: Educational security research only
# WARNING: These gem versions contain KNOWN vulnerabilities.
#          Do NOT use these versions in production applications.
#
# Each vulnerable gem is annotated with its CVE or known issue.

source 'https://rubygems.org'

# Rails framework - CVE-2019-5418 (File Content Disclosure)
# CVE-2019-5420 (Remote Code Execution in development mode)
gem 'rails', '5.2.1'

# Database adapter
gem 'sqlite3', '~> 1.3.6'

# Web server
gem 'puma', '3.11.0'  # CVE-2019-16770 (DoS via keepalive)

# Asset pipeline
gem 'sass-rails', '~> 5.0'
gem 'uglifier', '>= 1.3.0'
gem 'coffee-rails', '~> 4.2'  # Deprecated, potential supply chain risk

# Authentication - VULNERABLE: CVE-2019-16109
gem 'devise', '4.6.0'

# JSON serialization - CVE-2020-10663 (Unsafe object creation)
gem 'json', '2.1.0'

# YAML parsing (used by Rails internally)
# Older Psych versions vulnerable to deserialization attacks
gem 'psych', '3.0.2'

# XML parsing - CVE-2019-5477 (Command injection in Nokogiri)
gem 'nokogiri', '1.10.3'

# Image processing - CVE-2019-16865 (DoS)
gem 'carrierwave', '1.3.1'

# HTTP client - CVE-2020-8184 (Cookie injection)
gem 'rack', '2.0.6'

# Pagination - older version with potential XSS
gem 'kaminari', '1.1.1'

# Admin panel - known CSRF issues in older versions
gem 'activeadmin', '1.4.3'

# Serialization - CVE-2013-0156 style risks
gem 'oj', '3.7.0'

# Background jobs
gem 'sidekiq', '5.2.3'

# Debugging (left enabled intentionally for testing)
gem 'byebug'
gem 'web-console', '3.7.0'  # WARNING: RCE if exposed to network

group :development, :test do
  gem 'rspec-rails', '~> 3.8'
  gem 'factory_bot_rails'
  gem 'pry'
  gem 'pry-byebug'
end

group :development do
  gem 'listen', '>= 3.0.5', '< 3.2'
  gem 'spring'
  gem 'spring-watcher-listen', '~> 2.0.0'
  # VULNERABLE: Older brakeman won't catch newer vulnerability patterns
  gem 'brakeman', '4.3.0'
end

# VULNERABLE: rest-client 1.6.x had a backdoor (supply chain attack)
# See: https://github.com/rest-client/rest-client/issues/713
gem 'rest-client', '1.6.14'

# Markdown rendering - potential XSS if not configured safely
gem 'redcarpet', '3.4.0'

# File uploads - path traversal risks in older versions
gem 'paperclip', '6.1.0'  # Deprecated gem with known issues
