# RubyGuardian Environment Configuration
# Copy this file to .env and adjust values

# ─── General ────────────────────────────────────────────────────────────────
RUBY_ENV=development
LOG_LEVEL=info

# ─── C2 Server ──────────────────────────────────────────────────────────────
C2_HOST=127.0.0.1
C2_PORT=4444
C2_SECRET_KEY=change-me-in-production

# ─── Detection Agent ───────────────────────────────────────────────────────
DETECTION_ALERT_LEVEL=medium
DETECTION_POLL_INTERVAL=5

# ─── ML Classifier API ─────────────────────────────────────────────────────
CLASSIFIER_API_KEY=dev-key-change-in-production
CLASSIFIER_HOST=0.0.0.0
CLASSIFIER_PORT=8000
MODEL_PATH=./03_ml_classifier/models/saved_models

# ─── Elasticsearch ──────────────────────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX_PREFIX=ruby-guardian

# ─── Kibana ─────────────────────────────────────────────────────────────────
KIBANA_URL=http://localhost:5601

# ─── Grafana ────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

# ─── Honeypot ───────────────────────────────────────────────────────────────
HONEYPOT_RAILS_PORT=3000
HONEYPOT_GEM_SERVER_PORT=9292
HONEYPOT_LOG_DIR=/data/captures

# ─── Slack Alerts ───────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#ruby-guardian-alerts

# ─── Email Alerts ───────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
